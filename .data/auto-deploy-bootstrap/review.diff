+               'AI_MANAGER_SECURE_COOKIE': '0'}
+        process = subprocess.Popen([os.sys.executable, '-c', program], env=env)
+        base = f'http://127.0.0.1:{port}'
+        try:
+            for _ in range(100):
+                try:
+                    if httpx.get(base + '/api/auth-status').status_code == 200:
+                        break
+                except httpx.HTTPError:
+                    pass
+                time.sleep(.1)
+            else:
