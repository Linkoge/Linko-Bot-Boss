# One restricted "work" instance. Copy to ~/.config/linko-bot-manager-NAME.env (NAME = the unit instance name,
# e.g. linko-bot-manager@work.service reads linko-bot-manager-work.env). Plain KEY=VALUE lines, no quotes needed.

# Restricted mode: exactly one fixed project; no deploy, no self-edit, no host agent, no project add/remove.
AI_MANAGER_RESTRICTED=1
# The one project folder (a Git repository; keep .git out of Syncthing, see README "Restricted work instance").
AI_MANAGER_PROJECT=/home/work/Documents/work
# Own data directory (database, login, workspaces). Never share it with another instance.
AI_MANAGER_DATA=/home/work/.local/share/linko-bot-manager-work
# Own local port; the tunnel or proxy points here. The main instance defaults to 8787.
AI_MANAGER_PORT=8788
# The public hostname served for this instance (Host header check). localhost stays allowed for health checks.
AI_MANAGER_ALLOWED_HOSTS=localhost,127.0.0.1,work.example.com
# Secure cookies need HTTPS (Cloudflare Tunnel terminates it). Leave at 1 unless testing locally over HTTP.
AI_MANAGER_SECURE_COOKIE=1
# Optional: Claude/Codex executables, XAI_API_KEY for audio, AI_MANAGER_CLAUDE_MODELS ...
